# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
server/node_modules
npm-debug.log
yarn-error.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# Miscellaneous
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# Worktree port assignment
.worktree-port
.worktree-root
# Worktree remote cleanup breadcrumb (processed by github-sync on next main session)
.worktree-cleanup
# Planner-Worker slot state (plan 326) — per-slot, never shared across machines
# (.worktree-root and .worktree-port are already ignored below)
.worktree-plan
# On-demand remote link state (plan 388) — holds the link secret, never commit
.worktree-remote
.claude/.slot-pids
.claude/*.log
src/environments/environment.slot.ts

# Claude Code local config (never commit)
.claude/settings.local.json
.claude/worktrees/
.claude/.plan-write-ack
.claude/.session-state-path
.claude/.ship-baseline
.claude/.session-lock
.claude/.parallel-slot-a
.claude/.parallel-slot-b
.claude/.last-npm-install-hash
.claude/.last-npm-install-hash-server
.worktree-root
.worktree-port

# Legacy PID-suffixed handoff files (docs/session-state-<branch>-<PID>.md) are retired
# (Plan 295) — nothing generates them anymore, so no ignore rule is needed. The old
# docs/session-state-*-[0-9]*.md pattern was too broad and hid legit
# docs/session-state-<branch>.md files whose branch name ends in digits (e.g. the
# feat/session-YYYYMMDD placeholder). Do not re-add that pattern.
# Stable handoff is docs/session-state-${BRANCH}.md (no trailing -PID)

# Environment & secrets (never commit)
.env
.env.*
.env.local
.env.*.local
*.pem
*.key
migration-dump.json

# Claude Code runtime state inside tools
tools/**/.claude/

# Catalog seeder — runtime output (never commit)
tools/catalog-seeder/output/*
tools/catalog-seeder/dumps/
tools/catalog-seeder/logging.log
!tools/catalog-seeder/output/.gitkeep
# seed-products.json IS committed after admin review — intentionally not ignored
!tools/catalog-seeder/output/seed-products.json
tools/catalog-seeder/__pycache__/
tools/catalog-seeder/*.pyc

# Legacy FoodComposer SQL source — plan 300 closed with 0 mismatches on the
# final full-database sweep; re-obtain from the original export if a future
# re-audit is needed (see server/scripts/legacy-import/source-data/README.md)
server/scripts/legacy-import/source-data/*.sql

# MemPalace runtime data (vector DB, knowledge graph, config — never commit)
chroma.sqlite3
entities.json
mempalace.yaml
mine-progress.ps1

# Playwright MCP and UI Inspector artifacts (never commit)
.playwright-mcp/
.ui-inspector/

# Stray screenshots from browser automation (never commit)
*.png
*.jpg
*.jpeg

# Design snapshot assets are real deliverables, not stray screenshots — carve out
# assets/ and uploads/ (screenshots/ stays ignored: iteration shots, not design-of-record)
!.interface-design/source/assets/*.png
!.interface-design/source/uploads/*.png

# PWA manifest icons (plan 313) — real deliverables referenced by manifest.webmanifest,
# not stray screenshots. Without this they'd never deploy and the manifest would 404 them.
!public/icons/*.png

# System files
.DS_Store
Thumbs.db
.gstack/

backups/

# MemPalace
chroma.sqlite3
mine-progress.ps1

# One-time migration scripts
apply-*.js
.superpowers/

# Mobile audit credentials (local only)
.claude/reports/mobile-audit/.credentials.json

# Render audit credentials (local only)
.claude/reports/render-audit/.credentials.json

# Label audit — raw production DB dump (recipe names, internal user ids); regenerate
# locally with scripts/audit-labels.mjs instead of committing it. report.md (summary
# tables/counts only) still gets tracked.
.claude/reports/label-audit/data.json
.claude/reports/label-audit/merge-log-*.json
.claude/reports/label-audit/migrate-courses-log-*.json

# Session manifests — per-session runtime state, never commit
.claude/sessions/

# GCM diagnostic log — dumps all env vars including secrets
gcm-diagnose.log

# Local MongoDB data (dev-only instance on :27018)
.mongo-local/

# Design snapshot vendor drop — extracted into .interface-design/source/, zip not needed after that
/UI refactor and design.zip


# Generated by npm run build:schemas (Plan 321 Phase 2a)
server/generated

# Plan 405 — /design-port live-compare screenshots are per-run scratch, never committed
_claude-data/design-migration/live/
# ...but a Claude Design handoff's own assets/ and screenshots/ PNGs are part of the bundle
!.interface-design/handoffs/**/*.png

# Plan 408 — QA harness. Run PNGs are already ignored by the global *.png rule above; uncomment
# to also drop each run's shots/index.tsv (whether QA evidence is committed is not decided yet).
# bugs/qa-runs/*/shots/
bugs/qa-runs/.nightly.log
.claude/.qa-pids
