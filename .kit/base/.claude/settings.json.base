{
  "env": {
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(*)",
      "Bash(node scripts/worktree-clean.mjs:*)",
      "mcp__ide__getDiagnostics",
      "WebFetch",
      "WebSearch",
      "mcp__ide__getOpenEditors",
      "mcp__ide__getCurrentSelection",
      "mcp__ide__executeCode"
    ],
    "deny": [
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -d*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/lib/guard.mjs\" edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/lib/guard.mjs\" bash",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/bash.exe\" \"${CLAUDE_PROJECT_DIR}/scripts/session-startup.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/slot-stop.mjs\" --if-slot",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/lib/guard.mjs\" manifest",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/bash.exe\" \"${CLAUDE_PROJECT_DIR}/scripts/pre-compact-reminder.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/bash.exe\" \"${CLAUDE_PROJECT_DIR}/scripts/handoff-check.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": false,
  "disabledMcpjsonServers": [
    "github",
    "context7"
  ],
  "extraKnownMarketplaces": {
    "ai-workflow-kit-mods": {
      "source": {
        "source": "github",
        "repo": "WDD-CODER/ai-workflow-kit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "fleet@ai-workflow-kit-mods": true,
    "guards@ai-workflow-kit-mods": true,
    "ship-pilot@ai-workflow-kit-mods": true
  }
}
