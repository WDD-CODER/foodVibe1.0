# Server environment — copy to server/.env and fill in. Never commit real values.

# Write rate limit on /api/v1/data (POST/PUT/DELETE) per user per 15 minutes.
# Default 1000. 0 turns the limiter off (local use only).
DATA_WRITE_LIMIT_MAX=1000

# Gemini model chain (plan 395). Optional comma list, tried in order; when a model's
# free daily quota runs out the next one answers. Unset = the default in
# server/services/gemini-client.js:
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite
