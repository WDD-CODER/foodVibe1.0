# Server environment — copy to server/.env and fill in. Never commit real values.

# Write rate limit on /api/v1/data (POST/PUT/DELETE) per user per 15 minutes.
# Default 1000. 0 turns the limiter off (local use only).
DATA_WRITE_LIMIT_MAX=1000

# Gemini model chain (plans 395, 412). Optional comma list in order; when a model's free
# daily quota runs out the user is offered the next one. Names outside the catalog in
# server/services/gemini-client.js are skipped. Unset = the default there (largest daily
# quota first):
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3.6-flash,gemini-3.8-flash,gemini-3-flash-preview

# Database
# Local URI: used by the server in dev and by every script by default.
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/foodvibe_local
# The live Atlas URI never goes in this file: put MONGO_URI=... in server/.env.live (git-ignored).
# Only --target=atlas, npm run dev:remote and NODE_ENV=production read it. Render sets MONGO_URI in its dashboard.

# JWT secrets (server/db.js requires both)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Front desk (plans 558, 560) - names only; set the values in the Render dashboard / your own server/.env
# The service's public https address (links the server builds)
PUBLIC_BASE_URL=
# WhatsApp Cloud API access token (Wave 1b)
WHATSAPP_TOKEN=
# WhatsApp app secret, checks the X-Hub-Signature-256 of the webhook (Wave 1b)
WHATSAPP_APP_SECRET=
# Token for the webhook's GET verify handshake (Wave 1b)
WHATSAPP_VERIFY_TOKEN=
